<?xml version="1.0" encoding="utf-8"?>
<!DOCTYPE martif PUBLIC "ISO 12200:1999A//DTD MARTIF core (DXFcdV04)//EN" "TBXcdv04.dtd">
<!-- Generated from glossary.yaml by scripts/build-data.mjs: do not edit. -->
<martif type="TBX" xml:lang="en">
<martifHeader>
<fileDesc>
<sourceDesc>
<p>Nebula Design System glossary</p>
</sourceDesc>
</fileDesc>
</martifHeader>
<text>
<body>
<termEntry id="system-key">
<descrip>The public identifier of a system registered on My Nethesis.</descrip>
<descrip type="Usage note">Example: &quot;NETH-1234-5678-9ABC-DEF0-1234-5678-9ABC-DEF0&quot;.</descrip>
<langSet xml:lang="en">
<tig>
<term>System key</term>
</tig>
</langSet>
<langSet xml:lang="it">
<tig>
<term>Chiave di sistema</term>
</tig>
</langSet>
</termEntry>
<termEntry id="system-key--forbidden-chiave-sistema">
<langSet xml:lang="en">
<tig>
<term>System key</term>
<termNote type="administrativeStatus">forbidden</termNote>
</tig>
</langSet>
<langSet xml:lang="it">
<tig>
<term>Chiave sistema</term>
</tig>
</langSet>
</termEntry>
<termEntry id="system-key--forbidden-id-sistema">
<langSet xml:lang="en">
<tig>
<term>System key</term>
<termNote type="administrativeStatus">forbidden</termNote>
</tig>
</langSet>
<langSet xml:lang="it">
<tig>
<term>ID sistema</term>
</tig>
</langSet>
</termEntry>
<termEntry id="system-secret">
<descrip>The credential a system uses to connect to My Nethesis. It is shown only once, when it is generated.</descrip>
<descrip type="Usage note">Example: &quot;my_0123456789abcdef0123.0123456789abcdef0123456789abcdef01234567&quot;. In Italian, use &quot;Segreto di sistema&quot; like &quot;Chiave di sistema&quot;; &quot;il segreto del sistema &lt;name&gt;&quot; is fine only for a specific system.</descrip>
<langSet xml:lang="en">
<tig>
<term>System secret</term>
</tig>
</langSet>
<langSet xml:lang="it">
<tig>
<term>Segreto di sistema</term>
</tig>
</langSet>
</termEntry>
<termEntry id="system-secret--forbidden-segreto-del-sistema">
<langSet xml:lang="en">
<tig>
<term>System secret</term>
<termNote type="administrativeStatus">forbidden</termNote>
</tig>
</langSet>
<langSet xml:lang="it">
<tig>
<term>Segreto del sistema</term>
</tig>
</langSet>
</termEntry>
<termEntry id="system-secret--forbidden-token-di-sistema">
<langSet xml:lang="en">
<tig>
<term>System secret</term>
<termNote type="administrativeStatus">forbidden</termNote>
</tig>
</langSet>
<langSet xml:lang="it">
<tig>
<term>Token di sistema</term>
</tig>
</langSet>
</termEntry>
<termEntry id="system-secret--forbidden-token-di-registrazione">
<langSet xml:lang="en">
<tig>
<term>System secret</term>
<termNote type="administrativeStatus">forbidden</termNote>
</tig>
</langSet>
<langSet xml:lang="it">
<tig>
<term>Token di registrazione</term>
</tig>
</langSet>
</termEntry>
<termEntry id="system-secret--forbidden-token-di-autenticazione">
<langSet xml:lang="en">
<tig>
<term>System secret</term>
<termNote type="administrativeStatus">forbidden</termNote>
</tig>
</langSet>
<langSet xml:lang="it">
<tig>
<term>Token di autenticazione</term>
</tig>
</langSet>
</termEntry>
<termEntry id="subscription">
<descrip>The plan of a registered system, such as Community or Enterprise.</descrip>
<descrip type="Usage note">Do not call the subscription a &quot;registration&quot;. Registering a system, that is connecting it to My Nethesis, is fine: &quot;Register system&quot;.</descrip>
<descrip type="Translation needed">No</descrip>
<langSet xml:lang="en">
<tig>
<term>Subscription</term>
</tig>
</langSet>
</termEntry>
<termEntry id="subscription--forbidden-abbonamento">
<langSet xml:lang="en">
<tig>
<term>Subscription</term>
<termNote type="administrativeStatus">forbidden</termNote>
</tig>
</langSet>
<langSet xml:lang="it">
<tig>
<term>Abbonamento</term>
</tig>
</langSet>
</termEntry>
<termEntry id="subscription--forbidden-sottoscrizione">
<langSet xml:lang="en">
<tig>
<term>Subscription</term>
<termNote type="administrativeStatus">forbidden</termNote>
</tig>
</langSet>
<langSet xml:lang="it">
<tig>
<term>Sottoscrizione</term>
</tig>
</langSet>
</termEntry>
<termEntry id="add-on">
<descrip>An optional feature bought on NethShop and granted to a system, such as Threat Shield.</descrip>
<descrip type="Usage note">The Italian plural does not change: &quot;gli add-on&quot;.</descrip>
<descrip type="Translation needed">No</descrip>
<langSet xml:lang="en">
<tig>
<term>Add-on</term>
</tig>
</langSet>
</termEntry>
<termEntry id="add-on--forbidden-servizio-aggiuntivo">
<langSet xml:lang="en">
<tig>
<term>Add-on</term>
<termNote type="administrativeStatus">forbidden</termNote>
</tig>
</langSet>
<langSet xml:lang="it">
<tig>
<term>Servizio aggiuntivo</term>
</tig>
</langSet>
</termEntry>
<termEntry id="tier">
<descrip>The size of an add-on sold by size, that is how many devices or applications it covers.</descrip>
<descrip type="Usage note">A system that goes beyond its tier is &quot;Over the tier&quot; (&quot;Oltre la fascia&quot;). For the level of a subscription, such as Community or Enterprise, use &quot;Plan&quot; (&quot;Piano&quot;).</descrip>
<langSet xml:lang="en">
<tig>
<term>Tier</term>
</tig>
</langSet>
<langSet xml:lang="it">
<tig>
<term>Fascia</term>
</tig>
</langSet>
</termEntry>
<termEntry id="tier--forbidden-livello">
<langSet xml:lang="en">
<tig>
<term>Tier</term>
<termNote type="administrativeStatus">forbidden</termNote>
</tig>
</langSet>
<langSet xml:lang="it">
<tig>
<term>Livello</term>
</tig>
</langSet>
</termEntry>
<termEntry id="nethshop">
<descrip>The Nethesis online shop for Nethesis products and services, such as add-ons, appliances and training.</descrip>
<descrip type="Translation needed">No</descrip>
<langSet xml:lang="en">
<tig>
<term>NethShop</term>
</tig>
</langSet>
</termEntry>
<termEntry id="company">
<descrip>A distributor, a reseller or a customer in My Nethesis, with its users and systems.</descrip>
<descrip type="Usage note">Use &quot;Company&quot; for the generic case; use &quot;Distributor&quot;, &quot;Reseller&quot; or &quot;Customer&quot; when the level matters.</descrip>
<langSet xml:lang="en">
<tig>
<term>Company</term>
</tig>
</langSet>
<langSet xml:lang="it">
<tig>
<term>Azienda</term>
</tig>
</langSet>
</termEntry>
<termEntry id="company--forbidden-organizzazione">
<langSet xml:lang="en">
<tig>
<term>Company</term>
<termNote type="administrativeStatus">forbidden</termNote>
</tig>
</langSet>
<langSet xml:lang="it">
<tig>
<term>Organizzazione</term>
</tig>
</langSet>
</termEntry>
<termEntry id="threat-shield">
<descrip>A security service that blocks malicious IP addresses and domains using blocklists.</descrip>
<descrip type="Usage note">Its parts are &quot;Threat Shield IP&quot; and &quot;Threat Shield DNS&quot;.</descrip>
<descrip type="Translation needed">No</descrip>
<langSet xml:lang="en">
<tig>
<term>Threat Shield</term>
</tig>
</langSet>
</termEntry>
<termEntry id="multiwan">
<descrip>The NethSecurity feature that uses several internet connections together, for load balancing or failover.</descrip>
<descrip type="Translation needed">No</descrip>
<langSet xml:lang="en">
<tig>
<term>MultiWAN</term>
</tig>
</langSet>
</termEntry>
<termEntry id="flashstart">
<descrip>A third-party cloud filter that blocks unwanted websites through DNS, integrated in NethSecurity.</descrip>
<descrip type="Translation needed">No</descrip>
<langSet xml:lang="en">
<tig>
<term>FlashStart</term>
</tig>
</langSet>
</termEntry>
<termEntry id="blocklist">
<descrip>A list of items that are blocked, such as IP addresses or domains.</descrip>
<descrip type="Usage note">Its opposite is &quot;Allowlist&quot;.</descrip>
<descrip type="Translation needed">No</descrip>
<langSet xml:lang="en">
<tig>
<term>Blocklist</term>
</tig>
</langSet>
</termEntry>
<termEntry id="blocklist--forbidden-blacklist">
<langSet xml:lang="en">
<tig>
<term>Blocklist</term>
<termNote type="administrativeStatus">forbidden</termNote>
</tig>
</langSet>
<langSet xml:lang="it">
<tig>
<term>Blacklist</term>
</tig>
</langSet>
</termEntry>
<termEntry id="blocklist--forbidden-lista-nera">
<langSet xml:lang="en">
<tig>
<term>Blocklist</term>
<termNote type="administrativeStatus">forbidden</termNote>
</tig>
</langSet>
<langSet xml:lang="it">
<tig>
<term>Lista nera</term>
</tig>
</langSet>
</termEntry>
<termEntry id="allowlist">
<descrip>A list of items that are always allowed, such as IP addresses or domains, even when a blocklist contains them.</descrip>
<descrip type="Usage note">Its opposite is &quot;Blocklist&quot;.</descrip>
<descrip type="Translation needed">No</descrip>
<langSet xml:lang="en">
<tig>
<term>Allowlist</term>
</tig>
</langSet>
</termEntry>
<termEntry id="allowlist--forbidden-whitelist">
<langSet xml:lang="en">
<tig>
<term>Allowlist</term>
<termNote type="administrativeStatus">forbidden</termNote>
</tig>
</langSet>
<langSet xml:lang="it">
<tig>
<term>Whitelist</term>
</tig>
</langSet>
</termEntry>
<termEntry id="allowlist--forbidden-allow-list">
<langSet xml:lang="en">
<tig>
<term>Allowlist</term>
<termNote type="administrativeStatus">forbidden</termNote>
</tig>
</langSet>
<langSet xml:lang="it">
<tig>
<term>Allow list</term>
</tig>
</langSet>
</termEntry>
<termEntry id="allowlist--forbidden-lista-bianca">
<langSet xml:lang="en">
<tig>
<term>Allowlist</term>
<termNote type="administrativeStatus">forbidden</termNote>
</tig>
</langSet>
<langSet xml:lang="it">
<tig>
<term>Lista bianca</term>
</tig>
</langSet>
</termEntry>
<termEntry id="create">
<descrip>Make a new object that did not exist before, such as a user, a group or a firewall rule.</descrip>
<descrip type="Usage note">Name the object: &quot;Create user&quot;. Use &quot;Add&quot; when the object already exists and is only associated with another one.</descrip>
<langSet xml:lang="en">
<tig>
<term>Create</term>
</tig>
</langSet>
<langSet xml:lang="it">
<tig>
<term>Crea</term>
</tig>
</langSet>
</termEntry>
<termEntry id="add">
<descrip>Associate an object that already exists, for example add a user to a group.</descrip>
<descrip type="Usage note">Use &quot;Create&quot; when the object does not exist yet and is made from scratch.</descrip>
<langSet xml:lang="en">
<tig>
<term>Add</term>
</tig>
</langSet>
<langSet xml:lang="it">
<tig>
<term>Aggiungi</term>
</tig>
</langSet>
</termEntry>
<termEntry id="edit">
<descrip>Change the data of an object.</descrip>
<descrip type="Usage note">To replace a single value, such as a password, use &quot;Change&quot;.</descrip>
<langSet xml:lang="en">
<tig>
<term>Edit</term>
</tig>
</langSet>
<langSet xml:lang="it">
<tig>
<term>Modifica</term>
</tig>
</langSet>
</termEntry>
<termEntry id="edit--forbidden-cambia">
<langSet xml:lang="en">
<tig>
<term>Edit</term>
<termNote type="administrativeStatus">forbidden</termNote>
</tig>
</langSet>
<langSet xml:lang="it">
<tig>
<term>Cambia</term>
</tig>
</langSet>
</termEntry>
<termEntry id="change">
<descrip>Replace a single value with a new one, such as a password, a picture, the language or the number of licenses.</descrip>
<descrip type="Usage note">&quot;Change password&quot; (&quot;Cambia password&quot;). For the data of an object, use &quot;Edit&quot;. As a noun, &quot;change&quot; is &quot;modifica&quot;: &quot;Change history&quot; (&quot;Cronologia modifiche&quot;).</descrip>
<langSet xml:lang="en">
<tig>
<term>Change</term>
</tig>
</langSet>
<langSet xml:lang="it">
<tig>
<term>Cambia</term>
</tig>
</langSet>
</termEntry>
<termEntry id="change--forbidden-modifica">
<langSet xml:lang="en">
<tig>
<term>Change</term>
<termNote type="administrativeStatus">forbidden</termNote>
</tig>
</langSet>
<langSet xml:lang="it">
<tig>
<term>Modifica</term>
</tig>
</langSet>
</termEntry>
<termEntry id="delete">
<descrip>Permanently destroy an object, such as a contact, a firewall rule or a user.</descrip>
<descrip type="Usage note">Use &quot;Remove&quot; when the object only leaves a list or an association and still exists, for example a user removed from a group. For applications, use &quot;Uninstall&quot;. When the deletion has consequences beyond the object itself, ask for confirmation first: see Delete confirmation in the guidelines. In My Nethesis, which archives objects before deleting them, the permanent action is &quot;Destroy&quot;.</descrip>
<langSet xml:lang="en">
<tig>
<term>Delete</term>
</tig>
</langSet>
<langSet xml:lang="it">
<tig>
<term>Elimina</term>
</tig>
</langSet>
</termEntry>
<termEntry id="delete--forbidden-cancella">
<langSet xml:lang="en">
<tig>
<term>Delete</term>
<termNote type="administrativeStatus">forbidden</termNote>
</tig>
</langSet>
<langSet xml:lang="it">
<tig>
<term>Cancella</term>
</tig>
</langSet>
</termEntry>
<termEntry id="delete--forbidden-rimuovi">
<langSet xml:lang="en">
<tig>
<term>Delete</term>
<termNote type="administrativeStatus">forbidden</termNote>
</tig>
</langSet>
<langSet xml:lang="it">
<tig>
<term>Rimuovi</term>
</tig>
</langSet>
</termEntry>
<termEntry id="remove">
<descrip>Take an object out of a list or an association without destroying it, for example remove a user from a group.</descrip>
<descrip type="Usage note">Use &quot;Delete&quot; when the object is destroyed.</descrip>
<langSet xml:lang="en">
<tig>
<term>Remove</term>
</tig>
</langSet>
<langSet xml:lang="it">
<tig>
<term>Rimuovi</term>
</tig>
</langSet>
</termEntry>
<termEntry id="remove--forbidden-elimina">
<langSet xml:lang="en">
<tig>
<term>Remove</term>
<termNote type="administrativeStatus">forbidden</termNote>
</tig>
</langSet>
<langSet xml:lang="it">
<tig>
<term>Elimina</term>
</tig>
</langSet>
</termEntry>
<termEntry id="uninstall">
<descrip>Remove an application, with its data, from NethServer 8.</descrip>
<descrip type="Usage note">Name the application: &quot;Uninstall mail1&quot;.</descrip>
<langSet xml:lang="en">
<tig>
<term>Uninstall</term>
</tig>
</langSet>
<langSet xml:lang="it">
<tig>
<term>Disinstalla</term>
</tig>
</langSet>
</termEntry>
<termEntry id="uninstall--forbidden-elimina">
<langSet xml:lang="en">
<tig>
<term>Uninstall</term>
<termNote type="administrativeStatus">forbidden</termNote>
</tig>
</langSet>
<langSet xml:lang="it">
<tig>
<term>Elimina</term>
</tig>
</langSet>
</termEntry>
<termEntry id="uninstall--forbidden-rimuovi">
<langSet xml:lang="en">
<tig>
<term>Uninstall</term>
<termNote type="administrativeStatus">forbidden</termNote>
</tig>
</langSet>
<langSet xml:lang="it">
<tig>
<term>Rimuovi</term>
</tig>
</langSet>
</termEntry>
<termEntry id="archive">
<descrip>Take an object out of use without destroying it, so that it can be restored, such as a user, a system or a company.</descrip>
<descrip type="Usage note">Only in products that keep archived objects. Its opposite is &quot;Restore&quot;; the action that removes an archived object for good is &quot;Destroy&quot;.</descrip>
<langSet xml:lang="en">
<tig>
<term>Archive</term>
</tig>
</langSet>
<langSet xml:lang="it">
<tig>
<term>Archivia</term>
</tig>
</langSet>
</termEntry>
<termEntry id="restore">
<descrip>Bring back something kept earlier, such as an archived object or the configuration saved in a backup.</descrip>
<descrip type="Usage note">&quot;Restore user&quot; (&quot;Ripristina utente&quot;), &quot;Restore backup&quot; (&quot;Ripristina backup&quot;). For default values, use &quot;Reset&quot;.</descrip>
<langSet xml:lang="en">
<tig>
<term>Restore</term>
</tig>
</langSet>
<langSet xml:lang="it">
<tig>
<term>Ripristina</term>
</tig>
</langSet>
</termEntry>
<termEntry id="destroy">
<descrip>Permanently delete an archived object, which can no longer be restored.</descrip>
<descrip type="Usage note">Only in products that archive objects before deleting them, where it takes the place of &quot;Delete&quot;. In Italian, drop &quot;definitivamente&quot; when the object follows: &quot;Destroy user&quot; (&quot;Elimina utente&quot;).</descrip>
<langSet xml:lang="en">
<tig>
<term>Destroy</term>
</tig>
</langSet>
<langSet xml:lang="it">
<tig>
<term>Elimina definitivamente</term>
</tig>
</langSet>
</termEntry>
<termEntry id="enable">
<descrip>Turn on a feature or an option.</descrip>
<descrip type="Usage note">The resulting state is &quot;Enabled&quot; (&quot;Abilitato&quot;, not &quot;Attivato&quot;).</descrip>
<langSet xml:lang="en">
<tig>
<term>Enable</term>
</tig>
</langSet>
<langSet xml:lang="it">
<tig>
<term>Abilita</term>
</tig>
</langSet>
</termEntry>
<termEntry id="enable--forbidden-attiva">
<langSet xml:lang="en">
<tig>
<term>Enable</term>
<termNote type="administrativeStatus">forbidden</termNote>
</tig>
</langSet>
<langSet xml:lang="it">
<tig>
<term>Attiva</term>
</tig>
</langSet>
</termEntry>
<termEntry id="disable">
<descrip>Turn off a feature or an option.</descrip>
<descrip type="Usage note">The resulting state is &quot;Disabled&quot; (&quot;Disabilitato&quot;, not &quot;Disattivato&quot;).</descrip>
<langSet xml:lang="en">
<tig>
<term>Disable</term>
</tig>
</langSet>
<langSet xml:lang="it">
<tig>
<term>Disabilita</term>
</tig>
</langSet>
</termEntry>
<termEntry id="disable--forbidden-disattiva">
<langSet xml:lang="en">
<tig>
<term>Disable</term>
<termNote type="administrativeStatus">forbidden</termNote>
</tig>
</langSet>
<langSet xml:lang="it">
<tig>
<term>Disattiva</term>
</tig>
</langSet>
</termEntry>
<termEntry id="clear">
<descrip>Empty a search field, a selection or a filter.</descrip>
<descrip type="Usage note">&quot;Clear&quot; empties values; &quot;Reset&quot; brings them back to their defaults. For filters, use &quot;Clear selection&quot; (&quot;Azzera selezione&quot;) only inside a single dropdown filter that has nothing selected by default, &quot;Clear filter&quot; (&quot;Azzera filtro&quot;) when the only filter of a table or a collection is a text filter, and &quot;Reset&quot; in every other case: see the Table filters guidelines. The clear button of a search field is &quot;Clear search&quot; (&quot;Azzera ricerca&quot;).</descrip>
<langSet xml:lang="en">
<tig>
<term>Clear</term>
</tig>
</langSet>
<langSet xml:lang="it">
<tig>
<term>Azzera</term>
</tig>
</langSet>
</termEntry>
<termEntry id="clear--forbidden-pulisci">
<langSet xml:lang="en">
<tig>
<term>Clear</term>
<termNote type="administrativeStatus">forbidden</termNote>
</tig>
</langSet>
<langSet xml:lang="it">
<tig>
<term>Pulisci</term>
</tig>
</langSet>
</termEntry>
<termEntry id="clear--forbidden-svuota">
<langSet xml:lang="en">
<tig>
<term>Clear</term>
<termNote type="administrativeStatus">forbidden</termNote>
</tig>
</langSet>
<langSet xml:lang="it">
<tig>
<term>Svuota</term>
</tig>
</langSet>
</termEntry>
<termEntry id="clear--forbidden-cancella">
<langSet xml:lang="en">
<tig>
<term>Clear</term>
<termNote type="administrativeStatus">forbidden</termNote>
</tig>
</langSet>
<langSet xml:lang="it">
<tig>
<term>Cancella</term>
</tig>
</langSet>
</termEntry>
<termEntry id="reset">
<descrip>Bring values back to their defaults, for example the filters of a list.</descrip>
<descrip type="Usage note">&quot;Reset filters&quot; (&quot;Reimposta filtri&quot;), &quot;Reset selection&quot; (&quot;Reimposta selezione&quot;), &quot;Reset password&quot; (&quot;Reimposta password&quot;). In Italian, &quot;Ripristina&quot; is for restoring a backup.</descrip>
<langSet xml:lang="en">
<tig>
<term>Reset</term>
</tig>
</langSet>
<langSet xml:lang="it">
<tig>
<term>Reimposta</term>
</tig>
</langSet>
</termEntry>
<termEntry id="reset--forbidden-ripristina">
<langSet xml:lang="en">
<tig>
<term>Reset</term>
<termNote type="administrativeStatus">forbidden</termNote>
</tig>
</langSet>
<langSet xml:lang="it">
<tig>
<term>Ripristina</term>
</tig>
</langSet>
</termEntry>
<termEntry id="cancel">
<descrip>Abandon an unfinished action, such as a form or a confirmation, without saving anything.</descrip>
<descrip type="Usage note">In Italian &quot;Cancella&quot; means delete, so it would suggest that data is lost. To dismiss information with no pending changes, use &quot;Close&quot; (&quot;Chiudi&quot;): see Buttons and actions in the guidelines.</descrip>
<langSet xml:lang="en">
<tig>
<term>Cancel</term>
</tig>
</langSet>
<langSet xml:lang="it">
<tig>
<term>Annulla</term>
</tig>
</langSet>
</termEntry>
<termEntry id="cancel--forbidden-cancella">
<langSet xml:lang="en">
<tig>
<term>Cancel</term>
<termNote type="administrativeStatus">forbidden</termNote>
</tig>
</langSet>
<langSet xml:lang="it">
<tig>
<term>Cancella</term>
</tig>
</langSet>
</termEntry>
<termEntry id="details">
<descrip>The button that opens the page of an object, in a table row or a card.</descrip>
<descrip type="Usage note">An exception to the verb rule for buttons, for brevity: always with the eye icon, and with the object name for screen readers. &quot;Show details&quot; is for content that opens in place.</descrip>
<langSet xml:lang="en">
<tig>
<term>Details</term>
</tig>
</langSet>
<langSet xml:lang="it">
<tig>
<term>Dettagli</term>
</tig>
</langSet>
</termEntry>
<termEntry id="details--forbidden-visualizza">
<langSet xml:lang="en">
<tig>
<term>Details</term>
<termNote type="administrativeStatus">forbidden</termNote>
</tig>
</langSet>
<langSet xml:lang="it">
<tig>
<term>Visualizza</term>
</tig>
</langSet>
</termEntry>
<termEntry id="show">
<descrip>Make content visible in place, such as a password, more rows or the notifications.</descrip>
<descrip type="Usage note">Its opposite is &quot;Hide&quot; (&quot;Nascondi&quot;). &quot;Show more&quot; (&quot;Mostra di più&quot;), &quot;Show password&quot; (&quot;Mostra password&quot;). To open the page of an object, use &quot;Details&quot;; to open another page, use &quot;Go to&quot;.</descrip>
<langSet xml:lang="en">
<tig>
<term>Show</term>
</tig>
</langSet>
<langSet xml:lang="it">
<tig>
<term>Mostra</term>
</tig>
</langSet>
</termEntry>
<termEntry id="show--forbidden-visualizza">
<langSet xml:lang="en">
<tig>
<term>Show</term>
<termNote type="administrativeStatus">forbidden</termNote>
</tig>
</langSet>
<langSet xml:lang="it">
<tig>
<term>Visualizza</term>
</tig>
</langSet>
</termEntry>
<termEntry id="show--forbidden-vedi">
<langSet xml:lang="en">
<tig>
<term>Show</term>
<termNote type="administrativeStatus">forbidden</termNote>
</tig>
</langSet>
<langSet xml:lang="it">
<tig>
<term>Vedi</term>
</tig>
</langSet>
</termEntry>
<termEntry id="hide">
<descrip>Make content that was shown in place invisible again, such as a password.</descrip>
<descrip type="Usage note">Its opposite is &quot;Show&quot; (&quot;Mostra&quot;). &quot;Hide password&quot; (&quot;Nascondi password&quot;).</descrip>
<langSet xml:lang="en">
<tig>
<term>Hide</term>
</tig>
</langSet>
<langSet xml:lang="it">
<tig>
<term>Nascondi</term>
</tig>
</langSet>
</termEntry>
<termEntry id="collapse">
<descrip>Reduce a section, a card or a group to its title, hiding its content.</descrip>
<descrip type="Usage note">Its opposite is &quot;Expand&quot; (&quot;Espandi&quot;). &quot;Collapse all cards&quot; (&quot;Comprimi tutte le card&quot;). To make content disappear entirely, use &quot;Hide&quot;.</descrip>
<langSet xml:lang="en">
<tig>
<term>Collapse</term>
</tig>
</langSet>
<langSet xml:lang="it">
<tig>
<term>Comprimi</term>
</tig>
</langSet>
</termEntry>
<termEntry id="collapse--forbidden-collassa">
<langSet xml:lang="en">
<tig>
<term>Collapse</term>
<termNote type="administrativeStatus">forbidden</termNote>
</tig>
</langSet>
<langSet xml:lang="it">
<tig>
<term>Collassa</term>
</tig>
</langSet>
</termEntry>
<termEntry id="collapse--forbidden-riduci">
<langSet xml:lang="en">
<tig>
<term>Collapse</term>
<termNote type="administrativeStatus">forbidden</termNote>
</tig>
</langSet>
<langSet xml:lang="it">
<tig>
<term>Riduci</term>
</tig>
</langSet>
</termEntry>
<termEntry id="collapse--forbidden-chiudi">
<langSet xml:lang="en">
<tig>
<term>Collapse</term>
<termNote type="administrativeStatus">forbidden</termNote>
</tig>
</langSet>
<langSet xml:lang="it">
<tig>
<term>Chiudi</term>
</tig>
</langSet>
</termEntry>
<termEntry id="expand">
<descrip>Open a collapsed section, card or group to show its content.</descrip>
<descrip type="Usage note">Its opposite is &quot;Collapse&quot; (&quot;Comprimi&quot;). &quot;Expand all cards&quot; (&quot;Espandi tutte le card&quot;).</descrip>
<langSet xml:lang="en">
<tig>
<term>Expand</term>
</tig>
</langSet>
<langSet xml:lang="it">
<tig>
<term>Espandi</term>
</tig>
</langSet>
</termEntry>
<termEntry id="download">
<descrip>Save a file from the product to the user's computer, such as a backup or a report.</descrip>
<descrip type="Usage note">Its opposite is &quot;Upload&quot; (&quot;Carica&quot;). As a noun for network traffic, it stays in English: &quot;Download speed&quot; (&quot;Velocità di download&quot;).</descrip>
<langSet xml:lang="en">
<tig>
<term>Download</term>
</tig>
</langSet>
<langSet xml:lang="it">
<tig>
<term>Scarica</term>
</tig>
</langSet>
</termEntry>
<termEntry id="upload">
<descrip>Send a file from the user's computer to the product, such as a certificate or a backup.</descrip>
<descrip type="Usage note">Its opposite is &quot;Download&quot; (&quot;Scarica&quot;). As a noun for network traffic, it stays in English: &quot;Upload speed&quot; (&quot;Velocità di upload&quot;).</descrip>
<langSet xml:lang="en">
<tig>
<term>Upload</term>
</tig>
</langSet>
<langSet xml:lang="it">
<tig>
<term>Carica</term>
</tig>
</langSet>
</termEntry>
<termEntry id="sign-in">
<descrip>Enter a product with your credentials.</descrip>
<descrip type="Usage note">&quot;Login&quot; is fine as a noun or modifier: &quot;Login failed&quot;, &quot;last login&quot;, &quot;root login&quot;. Queue login in NethVoice is a different concept: agents &quot;log in to&quot; and &quot;log out of&quot; a queue.</descrip>
<langSet xml:lang="en">
<tig>
<term>Sign in</term>
</tig>
</langSet>
<langSet xml:lang="it">
<tig>
<term>Accedi</term>
</tig>
</langSet>
</termEntry>
<termEntry id="sign-in--forbidden-login">
<langSet xml:lang="en">
<tig>
<term>Sign in</term>
<termNote type="administrativeStatus">forbidden</termNote>
</tig>
</langSet>
<langSet xml:lang="it">
<tig>
<term>Login</term>
</tig>
</langSet>
</termEntry>
<termEntry id="sign-in--forbidden-effettua-il-login">
<langSet xml:lang="en">
<tig>
<term>Sign in</term>
<termNote type="administrativeStatus">forbidden</termNote>
</tig>
</langSet>
<langSet xml:lang="it">
<tig>
<term>Effettua il login</term>
</tig>
</langSet>
</termEntry>
<termEntry id="sign-out">
<descrip>Leave a product and end your session.</descrip>
<langSet xml:lang="en">
<tig>
<term>Sign out</term>
</tig>
</langSet>
<langSet xml:lang="it">
<tig>
<term>Esci</term>
</tig>
</langSet>
</termEntry>
<termEntry id="sign-out--forbidden-disconnetti">
<langSet xml:lang="en">
<tig>
<term>Sign out</term>
<termNote type="administrativeStatus">forbidden</termNote>
</tig>
</langSet>
<langSet xml:lang="it">
<tig>
<term>Disconnetti</term>
</tig>
</langSet>
</termEntry>
<termEntry id="sign-out--forbidden-logout">
<langSet xml:lang="en">
<tig>
<term>Sign out</term>
<termNote type="administrativeStatus">forbidden</termNote>
</tig>
</langSet>
<langSet xml:lang="it">
<tig>
<term>Logout</term>
</tig>
</langSet>
</termEntry>
<termEntry id="username">
<descrip>The name a user signs in with.</descrip>
<descrip type="Usage note">Translate it also in short labels: &quot;Username and password&quot; is &quot;Nome utente e password&quot;, not &quot;Utente e password&quot;.</descrip>
<langSet xml:lang="en">
<tig>
<term>Username</term>
</tig>
</langSet>
<langSet xml:lang="it">
<tig>
<term>Nome utente</term>
</tig>
</langSet>
</termEntry>
<termEntry id="username--forbidden-utente">
<langSet xml:lang="en">
<tig>
<term>Username</term>
<termNote type="administrativeStatus">forbidden</termNote>
</tig>
</langSet>
<langSet xml:lang="it">
<tig>
<term>Utente</term>
</tig>
</langSet>
</termEntry>
<termEntry id="username--forbidden-username">
<langSet xml:lang="en">
<tig>
<term>Username</term>
<termNote type="administrativeStatus">forbidden</termNote>
</tig>
</langSet>
<langSet xml:lang="it">
<tig>
<term>Username</term>
</tig>
</langSet>
</termEntry>
<termEntry id="two-factor-authentication">
<descrip>A sign-in that asks for a second proof besides the password, such as a code from an authenticator app.</descrip>
<descrip type="Usage note">Sentence case: &quot;Two-factor authentication&quot;. In short labels, after the full name appears on the page, &quot;2FA&quot; is fine: &quot;Revoke 2FA&quot; (&quot;Revoca 2FA&quot;).</descrip>
<langSet xml:lang="en">
<tig>
<term>Two-factor authentication</term>
</tig>
</langSet>
<langSet xml:lang="it">
<tig>
<term>Autenticazione a due fattori</term>
</tig>
</langSet>
</termEntry>
<termEntry id="two-factor-authentication--forbidden-autenticazione-a-2-fattori">
<langSet xml:lang="en">
<tig>
<term>Two-factor authentication</term>
<termNote type="administrativeStatus">forbidden</termNote>
</tig>
</langSet>
<langSet xml:lang="it">
<tig>
<term>Autenticazione a 2 fattori</term>
</tig>
</langSet>
</termEntry>
<termEntry id="two-factor-authentication--forbidden-doppio-fattore">
<langSet xml:lang="en">
<tig>
<term>Two-factor authentication</term>
<termNote type="administrativeStatus">forbidden</termNote>
</tig>
</langSet>
<langSet xml:lang="it">
<tig>
<term>Doppio fattore</term>
</tig>
</langSet>
</termEntry>
<termEntry id="alert">
<descrip>A notice raised when a monitored condition needs attention, such as a full disk or too many calls waiting in a queue.</descrip>
<langSet xml:lang="en">
<tig>
<term>Alert</term>
</tig>
</langSet>
<langSet xml:lang="it">
<tig>
<term>Allarme</term>
</tig>
</langSet>
</termEntry>
<termEntry id="backup-destination">
<descrip>A storage location where backups are saved.</descrip>
<langSet xml:lang="en">
<tig>
<term>Backup destination</term>
</tig>
</langSet>
<langSet xml:lang="it">
<tig>
<term>Destinazione di backup</term>
</tig>
</langSet>
</termEntry>
<termEntry id="backup-destination--forbidden-repository-di-backup">
<langSet xml:lang="en">
<tig>
<term>Backup destination</term>
<termNote type="administrativeStatus">forbidden</termNote>
</tig>
</langSet>
<langSet xml:lang="it">
<tig>
<term>Repository di backup</term>
</tig>
</langSet>
</termEntry>
<termEntry id="my-nethesis">
<descrip>The Nethesis administration portal, where systems are registered and managed.</descrip>
<descrip type="Usage note">Write &quot;My Nethesis&quot; in full. &quot;My&quot; is only an informal short form, not used in user interfaces. To refer to it indirectly, &quot;Nethesis administration portal&quot; (&quot;portale di amministrazione Nethesis&quot;) is also correct.</descrip>
<descrip type="Translation needed">No</descrip>
<langSet xml:lang="en">
<tig>
<term>My Nethesis</term>
</tig>
</langSet>
</termEntry>
<termEntry id="nethserver">
<descrip>The Nethesis open source server for small and medium businesses. From a web interface, it installs and manages applications, such as mail, file sharing and NethVoice, on one or more nodes.</descrip>
<descrip type="Usage note">&quot;NethServer 8&quot;, with the version, is also correct. Do not shorten it to &quot;NS8&quot;.</descrip>
<descrip type="Translation needed">No</descrip>
<langSet xml:lang="en">
<tig>
<term>NethServer</term>
</tig>
</langSet>
</termEntry>
<termEntry id="cluster">
<descrip>A group of NethServer nodes managed together from one web interface.</descrip>
<descrip type="Usage note">A cluster has one leader node; the other nodes are worker nodes.</descrip>
<descrip type="Translation needed">No</descrip>
<langSet xml:lang="en">
<tig>
<term>Cluster</term>
</tig>
</langSet>
</termEntry>
<termEntry id="node">
<descrip>A server that is part of a NethServer cluster and runs its applications.</descrip>
<descrip type="Usage note">&quot;Leader node&quot; (&quot;Nodo leader&quot;) manages the cluster; the others are &quot;Worker node&quot; (&quot;Nodo worker&quot;).</descrip>
<langSet xml:lang="en">
<tig>
<term>Node</term>
</tig>
</langSet>
<langSet xml:lang="it">
<tig>
<term>Nodo</term>
</tig>
</langSet>
</termEntry>
<termEntry id="hostname">
<descrip>The name of a server or a unit on the network, such as a node or a NethSecurity unit.</descrip>
<descrip type="Usage note">Lowercase inside a sentence: &quot;Change the hostname&quot; (&quot;Cambia il nome host&quot;).</descrip>
<langSet xml:lang="en">
<tig>
<term>Hostname</term>
</tig>
</langSet>
<langSet xml:lang="it">
<tig>
<term>Nome host</term>
</tig>
</langSet>
</termEntry>
<termEntry id="hostname--forbidden-hostname">
<langSet xml:lang="en">
<tig>
<term>Hostname</term>
<termNote type="administrativeStatus">forbidden</termNote>
</tig>
</langSet>
<langSet xml:lang="it">
<tig>
<term>Hostname</term>
</tig>
</langSet>
</termEntry>
<termEntry id="storage">
<descrip>The disk space where a system keeps its data, such as logs, backups or the data of its applications.</descrip>
<descrip type="Usage note">In Italian it is masculine: &quot;lo storage&quot;, &quot;Storage locale&quot;.</descrip>
<descrip type="Translation needed">No</descrip>
<langSet xml:lang="en">
<tig>
<term>Storage</term>
</tig>
</langSet>
</termEntry>
<termEntry id="storage--forbidden-archiviazione">
<langSet xml:lang="en">
<tig>
<term>Storage</term>
<termNote type="administrativeStatus">forbidden</termNote>
</tig>
</langSet>
<langSet xml:lang="it">
<tig>
<term>Archiviazione</term>
</tig>
</langSet>
</termEntry>
<termEntry id="storage--forbidden-spazio-di-archiviazione">
<langSet xml:lang="en">
<tig>
<term>Storage</term>
<termNote type="administrativeStatus">forbidden</termNote>
</tig>
</langSet>
<langSet xml:lang="it">
<tig>
<term>Spazio di archiviazione</term>
</tig>
</langSet>
</termEntry>
<termEntry id="nethsecurity">
<descrip>The Nethesis open source firewall for small and medium businesses, based on OpenWrt. Many installations can be managed from NethServer 8 with the NethSecurity controller.</descrip>
<descrip type="Usage note">Each installation is called a &quot;unit&quot;.</descrip>
<descrip type="Translation needed">No</descrip>
<langSet xml:lang="en">
<tig>
<term>NethSecurity</term>
</tig>
</langSet>
</termEntry>
<termEntry id="unit">
<descrip>A single NethSecurity installation, such as one managed by the NethSecurity controller.</descrip>
<descrip type="Usage note">Call the installation &quot;unit&quot;, also in technical texts: &quot;The unit IP address&quot;, &quot;Reset the unit&quot;. &quot;Firewall&quot; stays correct for the feature, as in &quot;firewall rules&quot;, and for the kind of product, as in &quot;NethSecurity is a firewall&quot;.</descrip>
<langSet xml:lang="en">
<tig>
<term>Unit</term>
</tig>
</langSet>
<langSet xml:lang="it">
<tig>
<term>Unità</term>
</tig>
</langSet>
</termEntry>
<termEntry id="unit--forbidden-unita-firewall">
<langSet xml:lang="en">
<tig>
<term>Unit</term>
<termNote type="administrativeStatus">forbidden</termNote>
</tig>
</langSet>
<langSet xml:lang="it">
<tig>
<term>Unità firewall</term>
</tig>
</langSet>
</termEntry>
<termEntry id="unit--forbidden-dispositivo">
<langSet xml:lang="en">
<tig>
<term>Unit</term>
<termNote type="administrativeStatus">forbidden</termNote>
</tig>
</langSet>
<langSet xml:lang="it">
<tig>
<term>Dispositivo</term>
</tig>
</langSet>
</termEntry>
<termEntry id="unit--forbidden-firewall">
<langSet xml:lang="en">
<tig>
<term>Unit</term>
<termNote type="administrativeStatus">forbidden</termNote>
</tig>
</langSet>
<langSet xml:lang="it">
<tig>
<term>Firewall</term>
</tig>
</langSet>
</termEntry>
<termEntry id="nethvoice">
<descrip>The Nethesis business phone system (VoIP PBX), installed as an application on NethServer 8. It includes NethVoice CTI, the web app users make and receive calls with, NethLink, its desktop app, and a mobile app also called NethVoice.</descrip>
<descrip type="Translation needed">No</descrip>
<langSet xml:lang="en">
<tig>
<term>NethVoice</term>
</tig>
</langSet>
</termEntry>
<termEntry id="nethvoice-cti">
<descrip>The NethVoice web app for users, to make and receive calls and manage contacts, call history and presence.</descrip>
<descrip type="Usage note">Write the full name. Exception: inside NethVoice, &quot;CTI&quot; alone is fine when the context is clear. The mobile app is called &quot;NethVoice&quot;, not &quot;NethCTI&quot;.</descrip>
<descrip type="Translation needed">No</descrip>
<langSet xml:lang="en">
<tig>
<term>NethVoice CTI</term>
</tig>
</langSet>
</termEntry>
<termEntry id="nethlink">
<descrip>The NethVoice CTI desktop app. It shows call notifications even when the browser is closed and supports click-to-call.</descrip>
<descrip type="Translation needed">No</descrip>
<langSet xml:lang="en">
<tig>
<term>NethLink</term>
</tig>
</langSet>
</termEntry>
<termEntry id="application">
<descrip>Software installed on NethServer 8 from the Software center, such as Mail, Nextcloud or NethVoice.</descrip>
<descrip type="Usage note">Always prefer &quot;Application&quot; to &quot;Instance&quot;; use &quot;Instance&quot; only when strictly necessary. &quot;App&quot; is fine for mobile and desktop apps, such as NethLink or the NethVoice mobile app.</descrip>
<langSet xml:lang="en">
<tig>
<term>Application</term>
</tig>
</langSet>
<langSet xml:lang="it">
<tig>
<term>Applicazione</term>
</tig>
</langSet>
</termEntry>
<termEntry id="application--forbidden-app">
<langSet xml:lang="en">
<tig>
<term>Application</term>
<termNote type="administrativeStatus">forbidden</termNote>
</tig>
</langSet>
<langSet xml:lang="it">
<tig>
<term>App</term>
</tig>
</langSet>
</termEntry>
<termEntry id="instance">
<descrip>A single installed copy of an application, such as mail1. The same application can be installed more than once.</descrip>
<descrip type="Usage note">Use &quot;Instance&quot; only when the context strictly requires one specific copy of an application, and &quot;Application&quot; would be misleading: for example, to choose among several copies of the same application (&quot;Choose a NethVoice instance&quot;). In every other case, use &quot;Application&quot;.</descrip>
<langSet xml:lang="en">
<tig>
<term>Instance</term>
</tig>
</langSet>
<langSet xml:lang="it">
<tig>
<term>Istanza</term>
</tig>
</langSet>
</termEntry>
<termEntry id="webtop">
<descrip>The groupware application for mail, calendars, contacts and shared documents, installed on NethServer 8.</descrip>
<descrip type="Translation needed">No</descrip>
<langSet xml:lang="en">
<tig>
<term>WebTop</term>
</tig>
</langSet>
</termEntry>
<termEntry id="nextcloud">
<descrip>The third-party application for file sharing and collaboration, installed on NethServer 8.</descrip>
<descrip type="Translation needed">No</descrip>
<langSet xml:lang="en">
<tig>
<term>Nextcloud</term>
</tig>
</langSet>
</termEntry>
</body>
</text>
</martif>
